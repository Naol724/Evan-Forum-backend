# Database Configuration
# For local development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=evan_forum

# For Render deployment (automatically provided by Render PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/database

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your_jwt_secret_key_here

# OpenAI/Groq API Key for chatbot
OPENAI_API_KEY=your_groq_api_key_here

# CORS Configuration
# Add your frontend URL(s) separated by commas
# For development: http://localhost:5173
# For production: https://your-frontend.onrender.com
CLIENT_URL=http://localhost:5173

# Email Configuration (for password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
